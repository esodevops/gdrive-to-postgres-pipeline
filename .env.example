DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_db
DB_USER=your_db_user
DB_PASSWORD=your_password
DRIVE_FOLDER_ID=your_ID
SERVICE_ACCOUNT_FILE=credentials/credentials_service_account.json
METABASE_PORT=3000

# Production runtime settings. See docs/production.md.
