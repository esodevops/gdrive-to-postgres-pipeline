# PIPELINE_RETRIES=2
# PIPELINE_TIMEOUT_MINUTES=60
# PIPELINE_ALERT_EMAIL=data-engineering@example.com
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/path/to/database-ca.pem
